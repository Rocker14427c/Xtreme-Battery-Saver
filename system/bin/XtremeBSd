#!/system/bin/bash
# shellcheck shell=bash
#
# This daemon deliberately runs from the module directory rather than relying
# on /system/bin being mounted.  KernelSU/ReSukiSU only mount a module's
# system/ directory when a metamodule is installed, so /system/bin/XtremeBSd
# and /system/bin/bash are not dependable locations there.
MODDIR="${XBS_MODDIR:-$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)}"
STATE_DIR="${XBS_STATE_DIR:-/data/local/tmp/XtremeBS}"
conf="${XBS_CONF:-$STATE_DIR/XtremeBS.conf}"
BASH_BIN="${XBS_BASH:-$MODDIR/system/bin/bash}"

declare -a active_events
declare -a cpus
declare -a cpu_freqs
declare -a hp_cpus
declare -a lp_cpus
declare -a lp_govs
declare -A lp_default_govs
declare -A xbs_offlined_cores # CPUs this daemon actually changed from online to offline.
declare -a RFKILL_CMD=() # Command and arguments used to control rfkill.
cpu_base_path="${XBS_CPU_BASE_PATH:-/sys/devices/system/cpu}"

# Helpers and one time things

getconf() {
  # Return the first, uncommented, exact key=value entry.  Values may contain
  # additional '=' characters (for example a path or custom command).
  local opt
  opt=$(awk -v key="$1" '
    /^[[:space:]]*#/ { next }
    index($0, key "=") == 1 {
      sub(/^[^=]*=/, "")
      print
      exit
    }
  ' "$conf" 2>/dev/null)
  [ -n "$opt" ] && printf '%s\n' "$opt" || printf '%s\n' "$2"
}

is_device() {
  # Normalize the state to exactly true/false.  Older Android builds can deny
  # one dumpsys service; screen state then falls back to dumpsys power.
  local what out
  what="$1"
  if [ "$what" = "low_power" ]; then
    if [ "$(settings get global low_power 2>/dev/null)" = "1" ]; then
      echo true
    else
      echo false
    fi
    return
  fi

  out=$(dumpsys deviceidle get "$what" 2>/dev/null | head -n 1 | tr -d '\r')
  case "$out" in
    *true*|*TRUE*) echo true; return ;;
    *false*|*FALSE*) echo false; return ;;
  esac

  if [ "$what" = "screen" ]; then
    out=$(dumpsys power 2>/dev/null | grep -m 1 -E 'mWakefulness=|Display Power: state=')
    case "$out" in
      *Awake*|*Dreaming*|*state=ON*) echo true; return ;;
      *Asleep*|*state=OFF*)          echo false; return ;;
    esac
  fi

  # Preserve the previous daemon behavior for unknown values, but do not
  # manufacture a false transition from an empty/failed command.
  printf '%s\n' "$out"
}

notif() {
  # dont notify if notify=false
  if [ "$(getconf notify true)" = "true" ]; then
    su -lp 2000 -c "cmd notification post -S bigtext -t 'XtremeBS' 'STATUS' \"$1\"" >/dev/null
  fi
}

log_msg() {
  case $1 in
    1)
      log_lvl="[INFO]" ;;
    2)
      log_lvl="[VERBOSE]" ;;
    3)
      log_lvl="[DEBUG]" ;;
  esac
  if [ "$log_level" -ge "$1" ]; then
    echo "$(date +"%m-%d-%Y %H:%M:%S") $log_lvl $2" >> "$log_file"
  fi
}

migrate() {
  local conf_v2="${conf}.v2"
  local conf_v1="${conf}.v1"
  local ctl_value delay_value log_value log_level_value trigger block

  log_msg 2 "version=2 was found without an event block; migrating legacy config"
  log_msg 1 "Migrating to v2 config"
  rm -f "$conf_v2"

  # Top-level options.
  printf 'version=2\n' > "$conf_v2"
  ctl_value=$(getconf ctl_file "")
  [ -n "$ctl_value" ] && printf 'ctl_file=%s\n' "$ctl_value" >> "$conf_v2"
  delay_value=$(getconf delay 3)
  printf 'delay=%s\n' "$delay_value" >> "$conf_v2"
  log_value=$(getconf log_file "$STATE_DIR/XtremeBS.log")
  printf 'log_file=%s\n' "$log_value" >> "$conf_v2"
  log_level_value=$(getconf log_level 1)
  printf 'log_level=%s\n' "$log_level_value" >> "$conf_v2"
  printf '\n' >> "$conf_v2"

  # Put legacy actions in the event that represented their old trigger.
  # Empty companion events keep the generated config explicit and editable.
  trigger=$(getconf trigger auto)
  case "$trigger" in
    auto)
      block=low_power
      printf 'low_power={\nkeep_on_charge=%s\n' "$(getconf keep_on_charge true)" >> "$conf_v2"
      ;;
    boot)
      block=boot
      printf 'boot={\nquit=false\n' >> "$conf_v2"
      ;;
    manual)
      block=manual
      printf 'manual={\n' >> "$conf_v2"
      ;;
    *)
      log_msg 1 "Unknown legacy trigger '$trigger'; using low_power"
      trigger=low_power
      block=low_power
      printf 'low_power={\nkeep_on_charge=%s\n' "$(getconf keep_on_charge true)" >> "$conf_v2"
      ;;
  esac

  printf 'handle_cores=%s\n' "$(getconf handle_cores false)" >> "$conf_v2"
  printf 'disable_cores=%s\n' "$(getconf disable_cores false)" >> "$conf_v2"
  printf 'handle_apps=%s\n' "$(getconf handle_apps false)" >> "$conf_v2"
  printf 'allowlist=%s\n' "$(getconf allowlist "$STATE_DIR/apps.allow")" >> "$conf_v2"
  printf 'denylist=%s\n' "$(getconf denylist "$STATE_DIR/apps.deny")" >> "$conf_v2"
  printf 'handle_gms=%s\n' "$(getconf handle_gms false)" >> "$conf_v2"
  printf 'handle_proc=%s\n' "$(getconf handle_proc false)" >> "$conf_v2"
  printf 'proc_file=%s\n' "$(getconf proc_file "$STATE_DIR/proc.list")" >> "$conf_v2"
  printf 'low_ram=%s\n' "$(getconf low_ram false)" >> "$conf_v2"
  printf 'doze=%s\n' "$(getconf doze false)" >> "$conf_v2"
  printf 'kill_wifi=%s\n' "$(getconf kill_wifi false)" >> "$conf_v2"
  printf '}\n\n' >> "$conf_v2"

  for block in charging screen_off boot manual low_power; do
    # Do not duplicate the block which already received the legacy settings.
    case "$block" in
      "$trigger") continue ;;
      low_power) [ "$trigger" = auto ] && continue ;;
    esac
    printf '%s={\n}\n' "$block" >> "$conf_v2"
  done

  # Keep the original configuration as a recoverable backup.  Writing the new
  # configuration to a sibling file then renaming it prevents a torn config.
  mv -f "$conf" "$conf_v1"
  mv -f "$conf_v2" "$conf"
  log_msg 1 "Migration complete; legacy backup: $conf_v1"
}

auto_map_cores() {
  local dir cpu freq max_freq=0 max_count=0 gov i is_high

  cpus=()
  cpu_freqs=()
  hp_cpus=()
  lp_cpus=()
  lp_govs=()
  lp_default_govs=()

  log_msg 2 "Auto-mapping CPU cores"
  for dir in "$cpu_base_path"/cpu[0-9]*; do
    [ -d "$dir" ] || continue
    cpu=${dir##*/}
    freq=""
    [ -r "$dir/cpufreq/cpuinfo_max_freq" ] && freq=$(cat "$dir/cpufreq/cpuinfo_max_freq" 2>/dev/null)
    cpus+=("$cpu")
    cpu_freqs+=("$freq")
    if [[ "$freq" =~ ^[0-9]+$ ]] && (( freq > max_freq )); then
      max_freq=$freq
    fi
  done

  if ((${#cpus[@]} == 0)); then
    log_msg 1 "No CPU directories found under $cpu_base_path"
    return
  fi

  # `disable_cores=auto` must never choose every CPU on a single-cluster SoC.
  # On multi-cluster devices, choose the highest-frequency cluster instead of
  # the old `uniq -u` heuristic (which missed equally clocked big cores).
  for freq in "${cpu_freqs[@]}"; do
    [ "$freq" = "$max_freq" ] && ((max_count++))
  done
  if (( max_freq > 0 && max_count < ${#cpus[@]} )); then
    for i in "${!cpus[@]}"; do
      [ "${cpu_freqs[$i]}" = "$max_freq" ] && hp_cpus+=("${cpus[$i]}")
    done
  elif (( max_count == ${#cpus[@]} )); then
    log_msg 1 "All CPUs report the same maximum frequency; disable_cores=auto will not offline every core"
  fi

  for cpu in "${cpus[@]}"; do
    is_high=false
    for dir in "${hp_cpus[@]}"; do
      [ "$cpu" = "$dir" ] && { is_high=true; break; }
    done
    [ "$is_high" = true ] && continue

    gov="$(cat "$cpu_base_path/$cpu/cpufreq/scaling_governor" 2>/dev/null)"
    if [ -n "$gov" ] && grep -qw powersave "$cpu_base_path/$cpu/cpufreq/scaling_available_governors" 2>/dev/null; then
      lp_cpus+=("$cpu")
      lp_govs+=("$gov")
    fi
  done

  log_msg 3 "High-power cores: ${hp_cpus[*]:-none}"
  log_msg 3 "Low-power cores supporting powersave: ${lp_cpus[*]:-none}"
}

find_rfkill_command() {
  local candidate
  RFKILL_CMD=()
  log_msg 2 "Searching for a valid rfkill command..."

  if command -v rfkill >/dev/null 2>&1; then
    RFKILL_CMD=(rfkill)
  elif command -v toybox >/dev/null 2>&1 && toybox rfkill --help >/dev/null 2>&1; then
    RFKILL_CMD=(toybox rfkill)
  else
    for candidate in /data/adb/ksu/bin/busybox /data/adb/magisk/busybox; do
      if [ -x "$candidate" ] && "$candidate" rfkill --help >/dev/null 2>&1; then
        RFKILL_CMD=("$candidate" rfkill)
        break
      fi
    done
  fi

  if ((${#RFKILL_CMD[@]})); then
    log_msg 2 "Found rfkill command: ${RFKILL_CMD[*]}"
  else
    log_msg 2 "No rfkill command found. Will rely on svc for WiFi control."
  fi
}

rfkill_soft_blocked() {
  ((${#RFKILL_CMD[@]})) || return 1
  "${RFKILL_CMD[@]}" list wifi 2>/dev/null | awk '/Soft blocked:/ { print $3; exit }'
}

update_status() {
  local status_file core governor online wifi light deep doze
  status_file="$STATE_DIR/XtremeBS.status"
  mkdir -p "$STATE_DIR" 2>/dev/null || return
  : > "$status_file"

  # CPU map.  cpu0 normally has no online node because the boot CPU cannot be
  # hotplugged, so treat a missing node as online rather than printing errors.
  for core in "${cpus[@]}"; do
    online=online
    if [ -r "$cpu_base_path/$core/online" ] && [ "$(cat "$cpu_base_path/$core/online" 2>/dev/null)" = "0" ]; then
      online=offline
    else
      governor=$(cat "$cpu_base_path/$core/cpufreq/scaling_governor" 2>/dev/null)
      [ "$governor" = powersave ] && online=powersave
    fi
    printf '%s: %s\n' "$core" "$online" >> "$status_file"
  done

  wifi=unknown
  if ((${#RFKILL_CMD[@]})); then
    case "$(rfkill_soft_blocked)" in
      yes) wifi=disabled ;;
      no)  wifi=enabled ;;
    esac
  fi

  light="$(dumpsys deviceidle get light 2>/dev/null)"
  deep="$(dumpsys deviceidle get deep 2>/dev/null)"
  if [ "$light" = IDLE ]; then
    doze=light
  elif [ "$deep" = IDLE ]; then
    doze=deep
  else
    doze=inactive
  fi

  printf 'Low RAM: %s\n' "$(getprop ro.config.low_ram 2>/dev/null)" >> "$status_file"
  printf 'WiFi: %s\n' "$wifi" >> "$status_file"
  printf 'Doze: %s\n' "$doze" >> "$status_file"
}

# Return valid CPU names requested by a disable_cores setting.  The helper
# deliberately excludes cpu0: it is normally the boot CPU and offlining it
# can freeze or reboot a device.
disable_core_targets() {
  local requested="$1" cpu
  case "$requested" in
    ''|false) return 0 ;;
    auto)
      for cpu in "${hp_cpus[@]}"; do
        [ -f "$cpu_base_path/$cpu/online" ] && printf '%s\n' "$cpu"
      done
      return 0
      ;;
  esac

  for cpu in $requested; do
    if [[ ! "$cpu" =~ ^cpu[0-9]+$ ]]; then
      log_msg 1 "Ignoring invalid disable_cores entry: $cpu"
    elif [ "$cpu" = cpu0 ]; then
      log_msg 1 "Refusing to offline cpu0 (boot CPU safety guard)"
    elif [ ! -f "$cpu_base_path/$cpu/online" ]; then
      log_msg 1 "Skipping $cpu: no writable online node"
    else
      printf '%s\n' "$cpu"
    fi
  done
}

write_cpu_online() {
  local cpu="$1" wanted="$2" node attempt err current
  CPU_ONLINE_CHANGED=false
  node="$cpu_base_path/$cpu/online"
  [ -f "$node" ] || { log_msg 1 "Skipping $cpu: online node is missing"; return 1; }

  current=$(cat "$node" 2>/dev/null)
  [ "$current" = "$wanted" ] && return 0
  for attempt in 1 2 3; do
    err=$(printf '%s\n' "$wanted" > "$node" 2>&1)
    sleep 0.1
    current=$(cat "$node" 2>/dev/null)
    if [ "$current" = "$wanted" ]; then
      CPU_ONLINE_CHANGED=true
      log_msg 3 "$cpu -> $([ "$wanted" = 0 ] && printf OFFLINE || printf ONLINE)${attempt:+ (attempt $attempt)}"
      return 0
    fi
    [ "$attempt" -lt 3 ] && sleep 0.3
  done

  log_msg 1 "$cpu: failed to set online=$wanted after 3 attempts${err:+ - $err}"
  return 1
}

apply_disabled_cores() {
  local cpu
  while IFS= read -r cpu; do
    [ -n "$cpu" ] || continue
    if write_cpu_online "$cpu" 0 && [ "$CPU_ONLINE_CHANGED" = true ]; then
      # Do not claim a core that was already offline before XtremeBS ran.
      # That lets cleanup preserve a kernel/user-selected offline state.
      xbs_offlined_cores["$cpu"]=1
    fi
  done < <(disable_core_targets "$1")
}

restore_disabled_cores() {
  local cpu
  while IFS= read -r cpu; do
    [ -n "$cpu" ] || continue
    if [ -z "${xbs_offlined_cores[$cpu]:-}" ]; then
      log_msg 3 "Leaving $cpu offline: it was not offlined by this daemon"
      continue
    fi
    if write_cpu_online "$cpu" 1; then
      unset "xbs_offlined_cores[$cpu]"
    fi
  done < <(disable_core_targets "$1")
}

set_powersave_governor() {
  local cpu="$1" node available current
  node="$cpu_base_path/$cpu/cpufreq/scaling_governor"
  available="$cpu_base_path/$cpu/cpufreq/scaling_available_governors"
  [ -r "$node" ] || { log_msg 2 "Skipping $cpu: governor node unavailable"; return 1; }
  grep -qw powersave "$available" 2>/dev/null || { log_msg 2 "Skipping $cpu: powersave governor unavailable"; return 1; }

  current=$(cat "$node" 2>/dev/null)
  [ -n "${lp_default_govs[$cpu]:-}" ] || lp_default_govs["$cpu"]="$current"
  [ "$current" = powersave ] && return 0
  if printf 'powersave\n' > "$node" 2>/dev/null; then
    log_msg 3 "Setting powersave on $cpu"
  else
    log_msg 1 "Failed to set powersave on $cpu"
    return 1
  fi
}

restore_governor() {
  local cpu="$1" node original
  node="$cpu_base_path/$cpu/cpufreq/scaling_governor"
  original="${lp_default_govs[$cpu]:-}"
  [ -n "$original" ] || return 0
  [ -w "$node" ] || { log_msg 1 "Cannot restore governor for $cpu"; return 1; }
  if [ "$(cat "$node" 2>/dev/null)" != "$original" ]; then
    if printf '%s\n' "$original" > "$node" 2>/dev/null; then
      log_msg 3 "Resetting $cpu governor to $original"
    else
      log_msg 1 "Failed to restore $cpu governor to $original"
      return 1
    fi
  fi
  # Capture the governor at the next activation, not at daemon boot.  A user
  # or thermal service may legitimately change it while no event is active.
  unset "lp_default_govs[$cpu]"
}

handle_core_targets() {
  local requested="$1" cpu
  case "$requested" in
    ''|false) return 0 ;;
    auto)
      printf '%s\n' "${lp_cpus[@]}"
      return 0
      ;;
  esac
  for cpu in $requested; do
    if [[ "$cpu" =~ ^cpu[0-9]+$ ]]; then
      printf '%s\n' "$cpu"
    else
      log_msg 1 "Ignoring invalid handle_cores entry: $cpu"
    fi
  done
}

apply_handled_cores() {
  local cpu
  while IFS= read -r cpu; do
    [ -n "$cpu" ] && set_powersave_governor "$cpu"
  done < <(handle_core_targets "$1")
}

restore_handled_cores() {
  local cpu
  while IFS= read -r cpu; do
    [ -n "$cpu" ] && restore_governor "$cpu"
  done < <(handle_core_targets "$1")
}

# Controller reads and writes share a small mkdir lock with XBSctl.  This
# avoids losing a command in the old `cat file; : > file` race window.
acquire_ctl_lock() {
  local lock_dir="${ctl_file}.lock" attempts=0
  while ! mkdir "$lock_dir" 2>/dev/null; do
    ((attempts++))
    [ "$attempts" -ge 50 ] && return 1
    sleep 0.1
  done
  return 0
}

release_ctl_lock() {
  rmdir "${ctl_file}.lock" 2>/dev/null || true
}

read_ctl_command() {
  local ctl_dir
  CTL_COMMAND=""
  [ -n "${ctl_file:-}" ] || return 1
  ctl_dir=$(dirname "$ctl_file")
  mkdir -p "$ctl_dir" 2>/dev/null || return 1
  acquire_ctl_lock || { log_msg 1 "Controller lock timed out; command will be retried"; return 1; }
  [ -s "$ctl_file" ] && CTL_COMMAND=$(cat "$ctl_file" 2>/dev/null)
  : > "$ctl_file"
  release_ctl_lock
  return 0
}

restart_daemon() {
  # Re-exec through the bundled Bash.  Executing $0 directly would consult its
  # /system/bin/bash shebang, which is absent when KernelSU has no metamodule.
  exec "$BASH_BIN" "$0"
}

# V1 read_config
read_config() {
  # Read config
  # delay in seconds
  delay=$(getconf delay 3)
  case "$delay" in
    ''|*[!0-9]*)
      log_msg 1 "Invalid delay '$delay'; using 3 seconds"
      delay=3
      ;;
  esac
  [ "$delay" -lt 1 ] && delay=1

  # trigger
  # auto|boot # <integer>
  trigger=$(getconf trigger "")
  [ -z "$trigger" ] && exit

  # Keep state on charge
  # true|false
  keep_on_charge=$(getconf keep_on_charge true)

  # handle_apps
  # false|kill|nice|suspend
  handle_apps=$(getconf handle_apps false)

  # allowlist (user apps)
  # a path /data/local/tmp/XtremeBS/apps.allow
  allowlist=$(getconf "allowlist" "/data/local/tmp/XtremeBS/apps.allow")

  # sanity check. Not allow user to suspend
  # everything without an allowlist. Will make
  # all apps unusable. Set handle_apps=false
  # and notify user
  [ ! -s "$allowlist" ] && [ "$handle_apps" = "suspend" ] && handle_apps="false" && notif "Alert!\nYou MUST have an allowlist!\nWill not suspend apps without one!"
  # log error here

  # denylist (system apps)
  # a path /data/local/tmp/XtremeBS/apps.deny
  denylist=$(getconf "denylist" "/data/local/tmp/XtremeBS/apps.deny")

  # handle_cores
  # auto|false|"cpu4 cpu5"
  handle_cores=$(getconf "handle_cores" "false")

  # disable_cores
  # false|auto|"cpu6 cpu7"
  disable_cores=$(getconf "disable_cores" "false")

  # handle_gms
  # false|kill|nice
  handle_gms=$(getconf "handle_gms" false)

  # handle_proc
  # true|false
  handle_proc=$(getconf "handle_proc" false)

  # proc_file
  # a path /data/local/tmp/XtremeBS/proc.list
  proc_file=$(getconf "proc_file" "/data/local/tmp/XtremeBS/proc.list")
  [ ! -s "$proc_file" ] && handle_proc="false"

  # set low_ram
  # true|false
  low_ram=$(getconf "low_ram" false)

  # set doze
  # false|light|deep
  doze=$(getconf doze false)

  # kill_wifi
  # true|false
  kill_wifi=$(getconf kill_wifi false)

  # May need this later
#  percent="$(dumpsys battery | grep level | cut -d' ' -f4)"

  notif "Config Loaded"
}


# Action stuff

enable_pwr_save() {
  if [ "$version" != "2" ]; then
    lock="1"
    echo -n "Enabling XtremeBS"
    notif "Enabling XtremeBS..."
    log_msg 1 "Enabling XtremeBS"
  fi
  # Handle Apps
  if [ "$handle_apps" != "false" ]; then
    for app in $(pm list packages -3 | cut -d: -f2- && [ -s "$denylist" ] && cat "$denylist"); do
      if grep -q -E "$app" "$allowlist"; then
        continue
      fi
      if [ "$handle_apps" = "nice" ]; then
        for i in $(pgrep "$app"); do
          log_msg 3 "Renicing $i"
          renice -n 19 "$i" &>/dev/null &
        done
      elif [ "$handle_apps" = "kill" ]; then
        log_msg 3 "Stopping $app"
        am force-stop "$app" &>/dev/null &
      else
        log_msg 3 "Suspending $app"
        am force-stop "$app" &>/dev/null &
        pm suspend "$app" &>/dev/null &
      fi
    done
  fi

  # Handle GMS , this will be leaving soon.
  # Not many need it, and proc_file can handle it
  if [ "$handle_gms" = "nice" ]; then
    log_msg 3 "Renicing GMS"
    renice -n 19 "$(pgrep com.google.android.gms)"
  elif [ "$handle_gms" = "kill" ]; then
    log_msg 3 "Disabling GMS"
    pm disable com.google.android.gms
    am force-stop com.google.android.gms
  else
    : # Do nothing
  fi
  # Handle processes
  if [ "$handle_proc" = "true" ]; then
    while [ "$lock" = "1" ]; do
      while read proc nice; do
        pid="$(pgrep $proc)"
        [ ! "$nice" ] && nice="10"
        if [ "$(cat /proc/$pid/stat | cut -d' ' -f19)" != "$nice" ]; then
          log_msg 3 "Renicing $proc to $nice"
          renice -n "$nice" "$pid"
        fi
      done < "$proc_file"
      sleep "$delay"
    done &
  fi
  # Low RAM
  if [ "$low_ram" = "true" ]; then
    log_msg 3 "Setting the low_ram flag"
    resetprop -n ro.config.low_ram true
  fi

  # Handle WiFi
  if [ "$kill_wifi" = "true" ]; then
    log_msg 3 "Disabling WiFi"
    if ((${#RFKILL_CMD[@]})); then
      log_msg 3 "Attempting to block with: ${RFKILL_CMD[*]}"
      "${RFKILL_CMD[@]}" block wifi >/dev/null 2>&1
      # Check whether rfkill actually worked; use svc as a final fallback.
      if [ "$(rfkill_soft_blocked)" != yes ]; then
        log_msg 3 "rfkill failed to block. Falling back to svc."
        svc wifi disable >/dev/null 2>&1
      fi
    else
      log_msg 3 "No rfkill command available. Using svc."
      svc wifi disable >/dev/null 2>&1
    fi
  fi

  # Handle Doze
  if [ "$doze" = "light" ]; then
    log_msg 3 "Enabling $doze Doze mode"
    dumpsys deviceidle force-idle light &>/dev/null
  fi
  if [ "$doze" = "deep" ]; then
    log_msg 3 "Enabling $doze Doze mode"
    dumpsys deviceidle force-idle deep &>/dev/null
  fi

  # CPU hotplug and cpufreq sysfs are outside Magisk's system overlay.  Do
  # not call magic_remount_* here: those functions are unavailable in many
  # KernelSU shells and are unnecessary for writable sysfs nodes.
  if [ "$handle_cores" != "false" ] || [ "$disable_cores" != "false" ]; then
    apply_disabled_cores "$disable_cores"
    apply_handled_cores "$handle_cores"
  fi

  if [ "$version" != "2" ]; then
    echo " - [done]"
    notif "status: Enabled"
    log_msg 1 "Enabled XtremeBS"
  fi

  update_status
}

disable_pwr_save() {
  if [ "$version" != "2" ]; then
    echo -n "Disabling XtremeBS"
    notif "Disabling XtremeBS..."
    log_msg 1 "Disabling XtremeBS"
  fi
  # Restore only the CPU settings this event requested.  Active events are
  # reconciled immediately by handle_event after an event exits.
  if [ "$handle_cores" != "false" ] || [ "$disable_cores" != "false" ]; then
    restore_disabled_cores "$disable_cores"
    restore_handled_cores "$handle_cores"
  fi

  # Handle Doze
  if [ "$doze" != "false" ]; then
    log_msg 3 "Disabling Doze mode"
    dumpsys deviceidle unforce &>/dev/null
  fi

  # Handle WiFi
  if [ "$kill_wifi" = "true" ]; then
    log_msg 3 "Enabling WiFi"
    if ((${#RFKILL_CMD[@]})); then
      log_msg 3 "Attempting to unblock with: ${RFKILL_CMD[*]}"
      "${RFKILL_CMD[@]}" unblock wifi >/dev/null 2>&1
      # Check whether rfkill actually worked; use svc as a final fallback.
      if [ "$(rfkill_soft_blocked)" != no ]; then
        log_msg 3 "rfkill failed to unblock. Falling back to svc."
        svc wifi enable >/dev/null 2>&1
      fi
    else
      log_msg 3 "No rfkill command available. Using svc."
      svc wifi enable >/dev/null 2>&1
    fi
  fi

  # Handle Apps
  if [ "$handle_apps" != "false" ]; then
    for app in $(pm list packages -3 | cut -d: -f2- && [ -s "$denylist" ] && cat "$denylist"); do
      if grep -q -E "$app" "$allowlist"; then
        continue
      fi
      if [ "$handle_apps" = "nice" ]; then
        for i in $(pgrep "$app"); do
          log_msg 3 "Resetting the nice level for $app"
          renice -n 0 "$i" &>/dev/null &
        done
      else
        log_msg 3 "Unsuspending $app"
        pm unsuspend "$app" &>/dev/null &
      fi
    done
  fi

  # Handle GMS
  if [ "$handle_gms" = "nice" ]; then
    log_msg 3 "Resetting the nice level for GMS"
    renice -n 0 "$(pgrep com.google.android.gms)"
  elif [ "$handle_gms" = "kill" ]; then
    log_msg 3 "Enabling GMS"
    pm enable com.google.android.gms
  else
    : # Do nothing
  fi
  # Handle Processes
  if [ "$handle_proc" = "true" ]; then
    while read proc nice; do
      log_msg 3 "Resetting the nice level for $proc"
      renice -n 0 "$(pgrep $proc)"
    done < "$proc_file"
  fi
  # Low RAM
  if [ "$low_ram" = "true" ]; then
    log_msg 3 "Setting low_ram to false"
    resetprop -n ro.config.low_ram false
  fi

  if [ "$version" != "2" ]; then
    lock="0"
    echo " - [done]"
    notif "status: Disabled"
    log_msg 1 "Disabled XtremeBS"
  fi

  update_status
}

# Event stuff for V2

is_event_locked() {
  event="$1"
  for i in ${!active_events[@]}; do
    if [ "${active_events[$i]}" = "$event" ]; then
      return 1
    fi
  done
  return 0
}

handle_event() {
  # flag: 1 = activate, 0 = deactivate, 2 = internal re-apply of an
  # already-active event after another event exited.
  local event="$1" flag="$2" reapply_event

  if [ "$flag" = 1 ]; then # we are trying to enable
    # check to see if its unlocked
    is_event_locked "$event"
    if [ $? != 0 ]; then
      # we tried to enable an already active event
      log_msg 2 "$event was triggered but it is currently enabled"
      # return early
      return 1
    else
      # lock the event
      active_events+=( "$event" )
    fi
  fi

  # set everything to false
  quit=false
  handle_cores=false
  disable_cores=false
  handle_apps=false
  allowlist=null
  denylist=null
  handle_proc=false
  proc_file=null
  handle_gms=false
  low_ram=false
  doze=false
  kill_wifi=false

  log_msg 3 "Parsing the config for $event event"

  # Parse exactly one event block.  The old grep -A99 form could consume a
  # following block after 99 lines and treated an event name as a regex.
  line=''
  while IFS= read -r line; do
    # README examples indent keys inside a block.  Normalize surrounding
    # whitespace before matching; previously "  disable_cores" silently
    # missed every case arm and made a valid-looking profile a no-op.
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    compact_line=${line//[[:space:]]/}
    [ "$compact_line" = "$event={" ] && continue
    [ "$compact_line" = "}" ] && break
    key=${line%%=*}
    val=${line#*=}
    key=${key#"${key%%[![:space:]]*}"}
    key=${key%"${key##*[![:space:]]}"}
    val=${val#"${val%%[![:space:]]*}"}
    val=${val%"${val##*[![:space:]]}"}
    case $key in
      keep_on_charge)
        if [ "$val" = "true" ] && \
        [ "$flag" = "0" ] && \
        [ "$event" != "charging" ] && \
        [ "$charging" = "true" ]; then
          log_msg 1 "$event has keep_on_charge set. We are keeping the settings until unplugged"
          return 0
        fi ;;
      quit)
        if [ "$val" = "true" ] && \
        [ "$event" = "boot" ]; then
          quit=true
        fi ;;
      handle_cores)
        if [ "$val" != "false" ]; then
          handle_cores="$val"
        fi ;;
      disable_cores)
        if [ "$val" != "false" ]; then
          disable_cores="$val"
        fi ;;
      handle_apps)
        if [ "$val" != "false" ]; then
          handle_apps="$val"
        fi ;;
      allowlist)
        if [ -f "$val" ]; then
          allowlist="$val"
        fi ;;
      denylist)
        if [ -f "$val" ]; then
          denylist="$val"
        fi ;;
      handle_proc)
        if [ "$val" != "false" ]; then
          handle_proc="$val"
        fi ;;
      proc_file)
        if [ -f "$val" ]; then
          proc_file="$val"
        fi ;;
      handle_gms)
        if [ "$val" != "false" ]; then
          handle_gms="$val"
        fi ;;
      low_ram)
        if [ "$val" = "true" ]; then
          low_ram="true"
        fi ;;
      doze)
        if [ "$val" != "false" ]; then
          doze="$val"
        fi ;;
      kill_wifi)
        if [ "$val" = "true" ]; then
          kill_wifi="true"
        fi;;
    esac
  done < <(
    awk -v target="$event" '
      {
        compact = $0
        gsub(/[[:space:]]/, "", compact)
        if (compact == target "={") inside = 1
        if (inside) print
        if (inside && compact == "}") exit
      }
    ' "$conf" 2>/dev/null
  )

  # perform sanity checks to prevent the user from killing themself
  if [ "$handle_apps" != "false" ] && [ "$allowlist" = "null" ] && [ "$denylist" = "null" ]; then
    handle_apps=false
  fi
  if [ "$handle_proc" != "false" ] && [ "$proc_file" = "null" ]; then
    handle_proc="false"
  fi

  # perform action using the old way
  # instead of a massive refactor which
  # is probably coming in a later update
  if [ "$flag" = 0 ]; then
    log_msg 1 "Undoing actions for $event"
    disable_pwr_save
    # remove from active_events
    for i in ${!active_events[@]}; do
      if [ "${active_events[$i]}" = "$event" ]; then
        unset "active_events[$i]"
      fi
    done
    log_msg 1 "Actions for $event undone"

    # The original daemon restored the exiting event and stopped there.  That
    # briefly (and sometimes permanently) undid restrictions from another
    # still-active event, e.g. screen_off re-enabled low_power's CPUs.  Reapply
    # the remaining events synchronously so their restrictions win again.
    if ((${#active_events[@]})); then
      log_msg 2 "Reapplying remaining active events after $event exited"
      for reapply_event in "${active_events[@]}"; do
        [ -n "$reapply_event" ] && handle_event "$reapply_event" 2
      done
    fi
  else
    log_msg 1 "Performing actions for $event event"
    enable_pwr_save
    log_msg 1 "Actions for $event completed"
    if [ "$event" = "boot" ] && [ "$flag" = "1" ] && \
    [ "$quit" = "true" ]; then
      log_msg 1 "Boot event has the quit option set. Killing the daemon."
      exit 0
    fi
  fi

  # A re-apply is an internal reconciliation; do not create a notification
  # storm while rebuilding the effective settings of active events.
  if [ "$flag" != "2" ]; then
    # build the active events notification
    for i in "${!active_events[@]}"; do
      active_notif+="${active_events[$i]} "
    done
    notif "Active Events: $active_notif"
    unset active_notif
  fi
}

init_v2() {

handle_event boot 1
charging="$(is_device charging)"
if [ "$charging" = "true" ]; then
  handle_event charging 1
fi
was_charging="$charging"
low_power="$(is_device low_power)"
if [ "$low_power" = "true" ]; then
  handle_event low_power 1
fi
was_low_power="$low_power"
screen_on="$(is_device screen)"
# here we invert because we only want to
# do something if the screen is off
if [ "$screen_on" = "false" ]; then
  handle_event screen_off 1
fi
was_screen_on="$screen_on"

while true; do

  # Check for one controller command without racing XBSctl.
  read_ctl_command
  cmd=${CTL_COMMAND%% *}
  if [ "$cmd" = "$CTL_COMMAND" ]; then
    cmd_event=""
  else
    cmd_event=${CTL_COMMAND#* }
  fi
  case $cmd in
    reload)
      # reload is for top level config opts
      for i in ${!active_events[@]}; do
        handle_event "${active_events[$i]}" 0
      done
      log_msg 2 "Reloading the config"
      restart_daemon
      ;;
    start)
      if [ ! "$cmd_event" ]; then
        log_msg 1 "The start command was received. Starting manual event"
        handle_event manual 1
      else
        log_msg 1 "The start command was received. Attempting to start $cmd_event"
        handle_event "$cmd_event" 1
      fi
      ;;
    stop)
      if [ ! "$cmd_event" ]; then
        log_msg 1 "The stop command was received. Stopping manual event"
        handle_event manual 0
      else
        log_msg 1 "The stop command was received. Attempting to start $cmd_event"
        for i in ${!active_events[@]}; do
          if [ "${active_events[$i]}" = "$cmd_event" ]; then
            handle_event "${active_events[$i]}" 0
          fi
        done
      fi
      ;;
    pause)
      resume=""
      until [ "$resume" = "resume" ]; do
        sleep "$delay"
        read_ctl_command
        resume="$CTL_COMMAND"
      done
      ;;
    safe)
      log_msg 1 "Entered Safe Mode"
      echo "safemode=1" >> "$conf"
      for i in ${!active_events[@]}; do
        handle_event "${active_events[$i]}" 0
      done
      for pkg in $(pm list packages | cut -d: -f2-); do
        pm unsuspend "$pkg"
      done
      notif "Safe Mode is Active"
      ready=""
      until [ "$ready" = "resume" ]; do
        sleep "$delay"
        read_ctl_command
        ready="$CTL_COMMAND"
      done
      log_msg 1 "Resume command received. Safe Mode Exited."
      sed -i '/safemode=1/d' "$conf"
      restart_daemon
      ;;
    *)
      :
      ;;
  esac

  # check charging state
  charging=$(is_device charging)
  if [ "$was_charging" != "" ]; then
    if [ "$charging" != "$was_charging" ]; then
      log_msg 2 "Charging event was triggered"
      if [ "$charging" = "true" ]; then
        handle_event charging 1
      else
        handle_event charging 0
      fi
    fi
  fi
  was_charging="$charging"

  # check low_power state
  low_power=$(is_device low_power)
  if [ "$was_low_power" != "" ]; then
    if [ "$low_power" != "$was_low_power" ]; then
      log_msg 2 "Low Power event was triggered"
      if [ "$low_power" = "true" ]; then
        handle_event low_power 1
      else
        handle_event low_power 0
      fi
    fi
  fi
  was_low_power="$low_power"

  # check screen change
  screen_on=$(is_device screen)
  if [ "$was_screen_on" != "" ]; then
    if [ "$screen_on" != "$was_screen_on" ]; then
      log_msg 2 "Screen change was detected"
      # here we invert because we only want to
      # do something if the screen is off
      if [ "$screen_on" = "false" ]; then
        handle_event screen_off 1
      else
        handle_event screen_off 0
      fi
    fi
  fi
  was_screen_on="$screen_on"

  sleep "$delay"
done
}

init_v1() {
  read_config
  while true; do
    # Check for command without racing XBSctl.
      read_ctl_command
      cmd="$CTL_COMMAND"
      case $cmd in
        reload)
          log_msg 1 "Reload command received"
          if [ "$lock" = "0" ]; then
            read_config
          else
            disable_pwr_save
            read_config
            enable_pwr_save
          fi
          log_msg 1 "Config reloaded"
          ;;
        stop)
          log_msg 1 "Stop command received"
          if [ "$lock" = "1" ]; then
            if [ "$trigger" != "manual" ]; then
              if [ "$tr_changed" = "true" ]; then
                trigger="$old_trigger"
                tr_changed="false"
              else
                old_trigger="$trigger"
                trigger="manual"
                tr_changed="true"
              fi
            fi
            disable_pwr_save
          fi
          log_msg 1 "Stopped XtremeBS"
          ;;
        start)
          log_msg 1 "Start command received"
          if [ "$lock" = "0" ]; then
            if [ "$trigger" != "manual" ]; then
              if [ "$tr_changed" = "true" ]; then
                trigger="$old_trigger"
                tr_changed="false"
              else
                old_trigger="$trigger"
                trigger="manual"
                tr_changed="true"
              fi
            fi
            enable_pwr_save
          fi
          log_msg 1 "Started XtremeBS"
          ;;
        pause)
          log_msg 1 "Pause command received"
          resume=""
          until [ "$resume" = "resume" ]; do
            sleep "$delay"
            read_ctl_command
            resume="$CTL_COMMAND"
          done
          log_msg 1 "Resume command received"
          ;;
        safe)
          echo "safemode=1" >> "$conf"
          log_msg 1 "Entering Safe Mode"
          disable_pwr_save
          # enhance safemode here
          # unsuspend all apps here
          # in the event every app
          # got suspended
          #
          # i think this will work.
          # not tested due to lazyness
          for pkg in $(pm list packages | cut -d: -f2-); do
            pm unsuspend "$pkg"
          done
          notif "Safe Mode is Active"
          ready=""
          until [ "$ready" = "resume" ]; do
            sleep "$delay"
            read_ctl_command
            ready="$CTL_COMMAND"
          done
          sed -i '/safemode=1/d' "$conf"
          log_msg 1 "Resume command received. Safe Mode Exited. Restarting Daemon."
          restart_daemon
          ;;
        *)
          :
          ;;
      esac

    # Check for trigger
    if [ "$trigger" = "boot" ]; then
      if [ "$lock" != "1" ]; then
        enable_pwr_save
      fi
    elif [ "$trigger" = "auto" ]; then
      if [ "$(settings get global low_power)" = "1" ] && [ "$lock" = "0" ]; then
        enable_pwr_save
      fi
      if [ "$(settings get global low_power)" = "0" ] && [ "$lock" = "1" ]; then
        if [ "$keep_on_charge" = "false" ] || [ "$(is_device charging)" = "false" ]; then
            disable_pwr_save
        fi
      fi
    else
      : # Do nothing, its Manual here
    fi

    # Wait
    sleep "$delay"
  done

}

# START

# Keep all runtime files under one writable directory.  This is intentionally
# outside the module tree so an in-place module update does not erase a user's
# configuration.
if ! mkdir -p "$STATE_DIR" 2>/dev/null; then
  echo "XtremeBS: cannot create state directory: $STATE_DIR" >&2
  exit 1
fi
umask 077

if [ ! -s "$conf" ]; then
  cat > "$conf" <<EOF
# XtremeBS v2 configuration
# Every event block is optional. Start with all features disabled, then add
# one setting at a time and reload from the WebUI or XBSctl reload.
version=2
delay=3
log_file=$STATE_DIR/XtremeBS.log
log_level=1
notify=true

boot={
}

charging={
}

low_power={
# keep_on_charge=true
}

screen_off={
}

manual={
}
EOF
  chmod 600 "$conf" 2>/dev/null || true
fi

has_event_block() {
  awk '
    {
      compact = $0
      gsub(/[[:space:]]/, "", compact)
      if (compact ~ /^[A-Za-z][A-Za-z0-9_.-]*=\{/) { found = 1; exit }
    }
    END { exit !found }
  ' "$conf" 2>/dev/null
}

# Set logging before migration: migration itself emits diagnostics.  Validate
# values originating in a hand-edited configuration so a malformed value does
# not turn the daemon into a busy loop.
version="$(getconf version 1)"
log_file="$(getconf log_file "$STATE_DIR/XtremeBS.log")"
log_level="$(getconf log_level 1)"
case "$log_level" in
  1|2|3) ;;
  *) log_level=1 ;;
esac
mkdir -p "$(dirname "$log_file")" 2>/dev/null || true
[ -f "$log_file" ] && mv -f "$log_file" "$log_file.old" 2>/dev/null || true

# Migrate a legacy config that explicitly selected v2 but does not yet contain
# an event block. Fresh installs already receive a complete v2 config above.
if [ "$version" = "2" ] && ! has_event_block; then
  migrate
  version="$(getconf version 2)"
  log_file="$(getconf log_file "$STATE_DIR/XtremeBS.log")"
  log_level="$(getconf log_level 1)"
  case "$log_level" in
    1|2|3) ;;
    *) log_level=1 ;;
  esac
fi

delay="$(getconf delay 3)"
case "$delay" in
  ''|*[!0-9]*)
    log_msg 1 "Invalid delay '$delay'; using 3 seconds"
    delay=3
    ;;
esac
[ "$delay" -lt 1 ] && delay=1

# Set up the controller before Safe Mode checks.  In prior versions this file
# was not created until the first polling pass, and Safe Mode spun at 100% CPU
# while repeatedly trying to read it.
ctl_file="$(getconf ctl_file "$STATE_DIR/xbs")"
mkdir -p "$(dirname "$ctl_file")" 2>/dev/null || true
: > "$ctl_file"
chmod 600 "$ctl_file" 2>/dev/null || true

# Persistent Safe Mode.  Poll at the configured interval and use the same
# locked controller protocol as normal operation.
safe="$(getconf safemode 0)"
if [ "$safe" = "1" ]; then
  log_msg 1 "Safemode was found in the config file, entering Safe Mode."
  notif "Safe Mode is Active"
  resume=""
  until [ "$resume" = "resume" ] || [ "$(getconf safemode 0)" = "0" ]; do
    sleep "$delay"
    read_ctl_command
    resume="$CTL_COMMAND"
  done
  sed -i '/^safemode=1$/d; /^safemode=0$/d' "$conf"
  log_msg 1 "Safemode exited. Restarting daemon."
  restart_daemon
fi

# Auto map cores in case a profile uses auto, then find rfkill once.
auto_map_cores
find_rfkill_command

if [ "$version" = "2" ]; then
  log_msg 1 "Starting XtremeBS v2"
  init_v2
else
  log_msg 1 "Starting XtremeBS in compatibility mode"
  log_msg 1 "Consider migrating by adding version=2 to the config"

  lock="0"
  tr_changed="false"
  init_v1
fi
